# Read by `npm run dev:emu` (vite --mode emulators) on top of .env. The
# emulators accept any values, and the demo- project id means a call that
# misses an emulator fails instead of reaching the real project.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-pump-track.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-pump-track
VITE_FIREBASE_STORAGE_BUCKET=demo-pump-track.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo
VITE_FIREBASE_MEASUREMENT_ID=
